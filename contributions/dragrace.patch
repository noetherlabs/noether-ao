diff --git a/tests/test_ao_tails.py b/tests/test_ao_tails.py
new file mode 100644
index 0000000..730c5a2
--- /dev/null
+++ b/tests/test_ao_tails.py
@@ -0,0 +1,67 @@
+"""AO case physics and tail reporting, with synthetic clocks only."""
+import json
+from pathlib import Path
+
+import pytest
+import yaml
+
+from dragrace.case import Case
+from dragrace.report import aggregate, render_text
+
+
+def test_ao_case_preserves_existing_mft_physics():
+    old = yaml.safe_load(Path('cases/pupil_to_focus/mft_array_scan.yaml').read_text())
+    new = yaml.safe_load(Path('cases/pupil_to_focus/mft_ao_scan.yaml').read_text())
+    for key in ('kind', 'algorithm_class', 'wavelength_m', 'output', 'dtype',
+                'basis_caching', 'accuracy'):
+        assert new[key] == old[key]
+    assert new['pupil']['diameter_m'] == old['pupil']['diameter_m']
+    assert new['pupil']['aperture'] == old['pupil']['aperture']
+    points = Case.from_dict(new).scan_cases()
+    assert [p.n_pupil for p in points] == [32, 64, 96, 128, 192, 256]
+    assert all(p.n_focus == 128 and p.n_across == p.n_pupil for p in points)
+
+
+def result(samples):
+    return {'case_id': 'ao', 'config_id': 'cpu', 'mode': 'timing', 'status': 'ok',
+            'adapter': {'name': 'example'}, 'machine': {'id': 'm', 'cpu': 'test'},
+            'accuracy': {'gate': 'pass'}, 'timing': {
+                'device_compute': samples,
+                'device_compute_stats': {'median': .001, 'min': .0005, 'p95': .002}}}
+
+
+@pytest.mark.parametrize('scan', [False, True])
+def test_tails_use_distribution_and_preserve_old_values(tmp_path, scan):
+    r = result([i / 1000 for i in range(100, 0, -1)])
+    if scan:
+        r['scan'] = {'parameter': 'n_pupil', 'points': [
+            {'scan_value': 32, 'timing': r.pop('timing'), 'status': 'ok',
+             'accuracy': r.pop('accuracy')}]}
+    (tmp_path / 'result.json').write_text(json.dumps(r))
+    rows = aggregate(tmp_path)
+    assert rows[0]['p99_s'] == .1
+    assert rows[0]['max_s'] == .1
+    assert rows[0]['median_s'] == .001
+    assert rows[0]['min_s'] == .0005
+    text = render_text(rows)
+    assert 'p99 ms' in text and 'max ms' in text and '100.000' in text
+
+
+@pytest.mark.parametrize('samples', [None, [], [float('nan')], [-1], ['bad'], 1, [True], {'x': 2}])
+def test_missing_or_invalid_distribution_is_not_invented(tmp_path, samples):
+    (tmp_path / 'result.json').write_text(json.dumps(result(samples)))
+    rows = aggregate(tmp_path)
+    assert rows[0]['p99_s'] is None and rows[0]['max_s'] is None
+    assert rows[0]['median_s'] == .001
+    assert 'nan' not in render_text(rows)
+
+
+def test_single_sample_and_excluded_rows(tmp_path):
+    r = result([.123])
+    (tmp_path / 'result.json').write_text(json.dumps(r))
+    rows = aggregate(tmp_path)
+    assert rows[0]['p99_s'] == rows[0]['max_s'] == .123
+    rows[0]['traced'] = True
+    assert '123.000' not in render_text(rows)
+    rows[0].update(traced=False, status='accuracy_fail')
+    assert '123.000' not in render_text(rows)
