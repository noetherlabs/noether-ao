# Freeze this protocol before computing cross-library comparisons.
grids: [32, 64, 96]
detector_n: 128
reference_wavelength_m: 7.5e-7
wavelength_sets_m:
  - [7.5e-7]
  - [6.5e-7, 7.5e-7, 8.5e-7]
separation_diameters: 0.6
phase_rms_rad: 0.05
derivative_step_rad: 1.0e-5
modes: [tilt_x, tilt_y, defocus, astigmatism_oblique, coma_x]
tolerances:
  intensity_relative_l2: 1.0e-10
  derivative_relative_l2: 1.0e-6
  total_power_absolute: 1.0e-12
  minimum_control_relative_l2: 1.0e-4
